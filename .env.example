# Jalankan npm.cmd run db:local untuk membuat .env otomatis (PostgreSQL lokal).
DATABASE_URL=postgresql://uas:UBAH_PASSWORD@127.0.0.1:55432/uas_local
PORT=3000
# Kosong = sesi baru ditutup. Kode maksimal 100 karakter; harus berbeda.
KODE_MULAI_UAS=
KODE_REKAP_DOSEN=GANTI_DENGAN_RAHASIA_DOSEN
EXAM_ID=uas-daya-v4-local
